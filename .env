# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                    Solar Monitor Configuration                             ║
# ║                                                                            ║
# ║ NOTA: Este archivo contiene credenciales. Protégelo en producción.       ║
# ║                                                                            ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# ─────── InfluxDB ──────────────────────────────────────────────────────────
# Usuario y contraseña para acceder a InfluxDB
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=changeme123
INFLUXDB_TOKEN=my-super-secret-token-changeme

# Organización y bucket (no modificar a menos que sepas qué haces)
INFLUXDB_ORG=solar
INFLUXDB_BUCKET=inverters

# ─────── Poller ────────────────────────────────────────────────────────────
# Intervalo en segundos entre lecturas automáticas de inversores
# Rango permitido: 10-3600 segundos
# Recomendado: 60 (1 minuto)
POLL_INTERVAL=60

# ─────── Dashboard ─────────────────────────────────────────────────────────
# Puerto HTTP donde se servirá el dashboard
# Ejemplos: 80 (HTTP estándar), 8080, 3000
DASHBOARD_PORT=80

# ─────── Notas ────────────────────────────────────────────────────────────
# 1. Después de cambiar POLL_INTERVAL, reinicia con: docker compose restart api
# 2. InfluxDB UI: http://localhost:8086
# 3. Dashboard: http://localhost (o puerto configurado)
# 4. API docs: http://localhost/api/docs
# 5. Para usar install.sh, estas variables se generan automáticamente
